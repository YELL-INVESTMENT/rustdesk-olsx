# Configuration du client OLSx.
# Lue par branding/apply.sh avant chaque compilation, en local comme dans la CI.
# Toute valeur laissee a REMPLIR fait echouer le build volontairement.

# Nom court utilise pour nommer les binaires publies.
# Exemple : olsx-remote-windows-x86_64.exe
ASSET_PREFIX="olsx-remote"

# Serveur de rendez-vous (hbbs). Hote seul, sans port, sauf si le port
# 21116 n'est pas celui utilise : dans ce cas "hote:port".
RENDEZVOUS_SERVER="23.88.6.102"

# Cle publique du serveur, contenu de /root/id_ed25519.pub cote hbbs.
RS_PUB_KEY="6fr9ewdWBJlZRz8jATnJcoYsBNAQscsz5HibtJp6JT0="

# Serveur API. Utile uniquement avec RustDesk Server Pro (console web,
# carnet d'adresses, comptes). Laisser vide avec la version open source.
API_SERVER=""

# Nom affiche dans l'application. Laisser RustDesk pour l'instant :
# un renommage complet touche aussi build.py, le paquet MSI et le bundle
# macOS, et sort du perimetre de cette premiere version.
APP_NAME="RustDesk"
